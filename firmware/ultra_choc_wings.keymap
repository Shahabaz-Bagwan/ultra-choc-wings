/*
 * Ultra Choc Wings default keymap (36 keys, QWERTY).
 *
 *  BASE   ╭ Q  W  E  R  T ╮   ╭ Y  U  I  O  P ╮
 *         │ A  S  D  F  G │   │ H  J  K  L  ; │
 *         │ Z  X  C  V  B │   │ N  M  ,  .  / │
 *         ╰  ESC SPC LWR  ╯   ╰ RSE ENT BSPC ╯
 *
 * LOWER: numbers and symbols. RAISE: navigation and F-keys.
 * LOWER + RAISE = ADJUST: Bluetooth, LED backlight, bootloader.
 *
 * The per-key LEDs are off by default to protect the coin cell. Toggle them
 * on the ADJUST layer; they also switch off by themselves when idle.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/backlight.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp Q        &kp W   &kp E     &kp R       &kp T           &kp Y      &kp U       &kp I      &kp O     &kp P
&kp A        &kp S   &kp D     &kp F       &kp G           &kp H      &kp J       &kp K      &kp L     &kp SEMI
&mt LSHFT Z  &kp X   &kp C     &kp V       &kp B           &kp N      &kp M       &kp COMMA  &kp DOT   &mt RSHFT FSLH
                     &mt LGUI ESC  &mt LCTRL SPACE  &mo LOWER    &mo RAISE  &mt RALT RET  &mt LALT BSPC
            >;
        };

        lower {
            display-name = "Lower";
            bindings = <
&kp N1       &kp N2    &kp N3    &kp N4     &kp N5          &kp N6     &kp N7     &kp N8     &kp N9    &kp N0
&kp EXCL     &kp AT    &kp HASH  &kp DLLR   &kp PRCNT       &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp SQT
&kp TAB      &kp CARET &kp AMPS  &kp STAR   &kp GRAVE       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp BSLH
                       &trans    &trans     &trans          &trans     &trans     &kp DEL
            >;
        };

        raise {
            display-name = "Raise";
            bindings = <
&kp F1       &kp F2    &kp F3    &kp F4     &kp F5          &kp PG_UP  &kp HOME   &kp UP     &kp END    &kp CAPS
&kp F6       &kp F7    &kp F8    &kp F9     &kp F10         &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &kp PSCRN
&kp F11      &kp F12   &kp C_VOL_DN &kp C_VOL_UP &kp C_PP   &kp TAB    &kp C_PREV &kp C_NEXT &kp C_MUTE &kp INS
                       &trans    &trans     &trans          &trans     &trans     &trans
            >;
        };

        adjust {
            display-name = "Adjust";
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &bl BL_TOG &bl BL_DEC &bl BL_INC &none &bootloader
&bt BT_CLR   &none        &none        &none        &none           &none      &none      &none      &none &sys_reset
&bt BT_CLR_ALL &none      &none        &none        &none           &none      &none      &none      &none &none
                          &trans       &trans       &trans          &trans     &trans     &trans
            >;
        };
    };
};
