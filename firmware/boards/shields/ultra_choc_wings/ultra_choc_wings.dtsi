/*
 * Shared by the dongle and both halves: the 36-key layout and matrix transform.
 *
 * Matrix (same on both halves, see config.yaml):
 *   rows: top = D8, home = D9, bottom = D10, thumbs = D4
 *   cols: pinky = D5, ring = D3, middle = D2, index = D1, inner = D0
 *   thumbs: inner thumb = D2, middle thumb = D1, home thumb = D0
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <layouts/foostan/corne/5column.dtsi>

&foostan_corne_5col_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7)
        >;
    };
};
