// Ultra Choc Wings uniboard case. Generated by scripts/make_case.py from the PCB;
// edit the parameters below, not the data.
//
// One piece holds both halves (left PCB switch side up, right PCB flipped)
// at a fixed splay. Each half drops into its pocket and sits flat on the
// floor (every SMD part is on the top side, so the bottom is bare), held by
// three M2 screws that self-tap into the floor. The CR2032 is reachable from
// the top; the top-edge notch clears the XIAO USB-C and the power switch.

/* [Layout] */
splay = 12;        // degrees each half is rotated away from straight
gap = 18;          // mm between the two halves at their closest point
/* [Walls] */
wall = 2.4;        // side wall thickness
floor_t = 3;       // floor under the PCB
clearance = 0.4;   // gap between PCB edge and pocket wall
pcb_t = 1.6;
lip = 1.0;         // wall height above the PCB top surface
/* [Screws] */
pilot_d = 1.7;     // M2 self-tapping pilot (use 3.2 for M2 heat-set inserts)
pilot_depth = 2.6;
/* [Details] */
xiao_relief_depth = 2;
notch_depth = 10;  // how far the top-edge notch reaches into the wall
center_tray = true; // hollow the deck between the halves
$fn = 48;

board = [[42.195, 62.881], [42.383, 62.824], [42.556, 62.731], [42.707, 62.607], [42.831, 62.456], [42.924, 62.283], [42.981, 62.095], [43.0, 61.9], [43.0, 55.4], [43.019, 55.205], [43.076, 55.017], [43.169, 54.844], [43.293, 54.693], [43.444, 54.569], [43.617, 54.476], [43.805, 54.419], [44.0, 54.4], [59.0, 54.4], [59.195, 54.381], [59.383, 54.324], [59.556, 54.231], [59.707, 54.107], [59.831, 53.956], [59.924, 53.783], [59.981, 53.595], [60.0, 53.4], [60.0, 52.0], [60.019, 51.805], [60.076, 51.617], [60.169, 51.444], [60.293, 51.293], [60.444, 51.169], [60.617, 51.076], [60.805, 51.019], [61.0, 51.0], [76.0, 51.0], [76.195, 50.981], [76.383, 50.924], [76.556, 50.831], [76.707, 50.707], [76.831, 50.556], [76.924, 50.383], [76.981, 50.195], [77.0, 50.0], [77.0, 1.0], [76.981, 0.805], [76.924, 0.617], [76.831, 0.444], [76.707, 0.293], [76.556, 0.169], [76.383, 0.076], [76.195, 0.019], [76.0, -0.0], [75.581, -0.0], [75.375, -0.021], [75.178, -0.085], [74.999, -0.187], [74.844, -0.324], [74.721, -0.49], [74.634, -0.678], [74.588, -0.879], [74.584, -1.086], [74.623, -1.289], [74.703, -1.48], [77.279, -6.194], [77.394, -6.361], [77.54, -6.502], [77.712, -6.61], [77.901, -6.681], [78.102, -6.713], [78.304, -6.704], [78.5, -6.654], [78.683, -6.565], [78.844, -6.442], [78.976, -6.288], [79.797, -5.116], [79.925, -4.967], [80.079, -4.846], [80.254, -4.757], [80.443, -4.704], [80.638, -4.689], [80.833, -4.713], [81.019, -4.774], [81.19, -4.87], [94.296, -14.047], [94.445, -14.175], [94.566, -14.329], [94.655, -14.504], [94.708, -14.693], [94.722, -14.888], [94.699, -15.083], [94.638, -15.269], [94.542, -15.44], [85.938, -27.727], [85.811, -27.876], [85.656, -27.997], [85.482, -28.086], [85.293, -28.138], [85.097, -28.153], [84.903, -28.13], [84.716, -28.069], [84.546, -27.973], [73.578, -20.294], [73.411, -20.199], [73.229, -20.138], [73.038, -20.113], [72.846, -20.125], [72.66, -20.174], [59.69, -24.942], [59.508, -24.99], [59.32, -25.003], [59.133, -24.981], [33.668, -19.463], [33.461, -19.44], [33.253, -19.461], [33.055, -19.525], [32.873, -19.628], [32.717, -19.767], [32.193, -20.313], [31.64, -20.831], [31.061, -21.32], [30.457, -21.778], [29.831, -22.204], [29.182, -22.596], [28.515, -22.954], [27.829, -23.277], [27.128, -23.563], [26.412, -23.812], [25.685, -24.024], [24.947, -24.197], [24.201, -24.332], [23.45, -24.427], [22.694, -24.483], [21.937, -24.5], [21.179, -24.477], [20.424, -24.414], [19.674, -24.312], [18.929, -24.171], [18.193, -23.991], [17.467, -23.773], [16.754, -23.518], [16.055, -23.225], [15.373, -22.897], [14.708, -22.533], [14.063, -22.135], [13.44, -21.704], [12.841, -21.241], [12.266, -20.747], [11.718, -20.224], [11.198, -19.673], [10.707, -19.095], [10.248, -18.493], [9.82, -17.867], [9.426, -17.221], [9.066, -16.554], [8.741, -15.869], [8.452, -15.169], [8.201, -14.454], [8.117, -14.263], [7.994, -14.094], [7.84, -13.954], [7.659, -13.849], [7.461, -13.784], [-8.023, -10.428], [-8.215, -10.366], [-8.391, -10.266], [-8.543, -10.133], [-8.665, -9.973], [-8.752, -9.791], [-8.801, -9.595], [-8.81, -9.394], [-8.778, -9.194], [-8.707, -9.006], [-8.599, -8.835], [-8.46, -8.689], [-8.237, -8.5], [-9.0, -8.5], [-9.0, 61.9], [-8.981, 62.095], [-8.924, 62.283], [-8.831, 62.456], [-8.707, 62.607], [-8.556, 62.731], [-8.383, 62.824], [-8.195, 62.881], [-8.0, 62.9], [42.0, 62.9]];
holes = [[73.0, -3.0], [24.5, 59.5], [2.0, -10.8]];
xiao_relief = [-9.14, 42.75, 8.95, 64.41]; // [x0, y0, x1, y1]
notch_x = [-10.14, 22.0];
board_top = 62.9;
coin = [22.0, -10.0];

// Place the left half so its inner edge sits gap/2 left of x = 0.
function rot(p, a) = [p[0] * cos(a) - p[1] * sin(a), p[0] * sin(a) + p[1] * cos(a)];
inner_x = max([for (p = board) rot(p, -splay)[0]]);

module place_left() translate([-gap / 2 - inner_x, 0]) rotate(-splay) children();
module place_right() mirror([1, 0]) place_left() children();
module both() { place_left() children(); place_right() children(); }

h = floor_t + pcb_t + lip;

module board_shape() polygon(board);

module outer_shape() offset(r = wall + clearance) hull() both() board_shape();

module pockets() both() offset(delta = clearance) board_shape();

module case() {
    difference() {
        linear_extrude(h) outer_shape();
        // PCB pockets
        translate([0, 0, floor_t]) linear_extrude(h) pockets();
        // Deck between the halves
        if (center_tray)
            translate([0, 0, floor_t]) linear_extrude(h)
                // offset in, then out: drops slivers too thin to be useful
                offset(r = 3) offset(delta = -3) difference() {
                    offset(r = -wall) outer_shape();
                    offset(r = wall + clearance) both() board_shape();
                }
        // XIAO pin relief
        translate([0, 0, floor_t - xiao_relief_depth]) linear_extrude(h)
            both() offset(delta = 1)
                translate([xiao_relief[0], xiao_relief[1]])
                    square([xiao_relief[2] - xiao_relief[0], xiao_relief[3] - xiao_relief[1]]);
        // USB-C / power switch notch in the top wall
        translate([0, 0, floor_t]) linear_extrude(h)
            both() translate([notch_x[0], board_top - 1])
                square([notch_x[1] - notch_x[0], notch_depth]);
        // M2 pilot holes
        both() for (p = holes) translate([p[0], p[1], floor_t - pilot_depth])
            linear_extrude(pilot_depth + 0.01) circle(d = pilot_d);
    }
}

case();
